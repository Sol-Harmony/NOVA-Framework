<div style="margin-top:0;">
    <h1 style="color:white;">NOVA</h1>
    <button id="loadDataBtn" style="color:white;">Ajax</button>
    <div id="result" style="margin-top: 1rem; color: white;"></div>
</div>
<script>
    let eventWithTimeout;
    function clearResultAfterDelay() {
        if (eventWithTimeout) {
            clearTimeout(eventWithTimeout);
        }
        eventWithTimeout = setTimeout(function() {
            jQuery("#result").html("");
        }, 3000);
    }
    jQuery(document).ready(function() {
        jQuery("#loadDataBtn").on("click", function() {
            jQuery.ajax({
                url: "/home/data", // this hits home->dataAction
                method: "GET",
                dataType: "json",
                success: function(data) {
                    jQuery("#result").html(`
                    <h3>${data.message}</h3>
                    <h3>${data.timestamp}</h3>
                `);
                    clearResultAfterDelay();
                },
                error: function(jqXHR) {
                    jQuery("#result").html(`<span style="color:red;">Error: ${jqXHR.statusText || "Network error"}</span>`);
                    clearResultAfterDelay();
                }
            });
        });
    });
</script>